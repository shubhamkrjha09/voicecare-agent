# Copy to .env and fill in your own keys. Never commit .env.

# Speech-to-text and text-to-speech
ELEVENLABS_API_KEY=
# ElevenLabs voice ID. Free plans must use a "premade" voice (default: Bella)
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us

# LLM: "sarvam" (default) or "google"
LLM_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Extra caller languages besides English (ISO codes, comma-separated), e.g. hi,bn,ta,te,mr
CALLER_LANGUAGES=hi,bn

# Voice model: eleven_v3 (clearest Hindi/Bengali, default) or eleven_flash_v2_5 (fastest, fewer credits)
ELEVENLABS_TTS_MODEL=eleven_v3
